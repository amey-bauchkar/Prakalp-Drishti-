# PRAKALP-DRISHTI — local runtime configuration
#
# THIS FILE IS GITIGNORED AND MUST STAY THAT WAY. It holds a live third-party
# credential. Never commit it, never paste it into an issue, never bake it into
# a container image.
#
# AIR-GAP NOTE: GROQ_API_KEY is what switches the copilot from the offline
# deterministic engine to a cloud LLM. Leaving it BLANK is the sovereign
# default: the system then answers from locally computed, Merkle-signed facts
# and makes no outbound request. Set it only for a connected demo.

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

PRAKALP_HOST=127.0.0.1
PRAKALP_PORT=8000
PRAKALP_SECRET_KEY=change-me-generate-with-secrets.token_hex(24)
PRAKALP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
