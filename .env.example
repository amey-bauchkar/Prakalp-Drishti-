# PRAKALP-DRISHTI — runtime configuration TEMPLATE
#
# Copy to `.env` and fill in. This file is COMMITTED and must never contain a
# real credential; `.env` is gitignored and is where live values belong.
#
#     cp .env.example .env
#
# A previous revision of this template carried the note "THIS FILE IS
# GITIGNORED", which was wrong and dangerous in the specific way that matters:
# it invited someone to paste a live key into the one file in this pair that
# git does track.


# ── LLM (optional) ──────────────────────────────────────────────────────────
#
# BLANK IS THE SOVEREIGN DEFAULT. With no key the copilot answers from locally
# computed, Merkle-signed facts and makes no outbound request at all — that is
# the air-gapped posture, not a degraded mode. Set a key only for a connected
# demo, and expect `posture()` to report outbound calls enabled.
#
# Generate at https://console.groq.com/keys — never commit the result.
GROQ_API_KEY=

# openai/gpt-oss-120b is a REASONING model: its token budget is consumed by the
# reasoning trace before any content is emitted. The application sizes
# max_tokens for that; a smaller budget returns empty content and silently
# drops every answer to the deterministic path.
#
# Do NOT set llama-3.3-70b-versatile here. It is retired and answers 404; it
# was the default in an earlier revision of this file and cost real debugging
# time to rediscover.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_S=20

# Optional second provider for the reconnaissance briefing. Inert when blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash


# ── Server ──────────────────────────────────────────────────────────────────
PRAKALP_HOST=127.0.0.1
PRAKALP_PORT=8000
PRAKALP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000


# ── Signing secret (REQUIRED in any deployment serving imagery) ─────────────
#
# This key signs the time-limited satellite imagery URLs. Leaving the
# placeholder means every reader of this repository can mint links that the
# server will honour, which defeats the entire point of signing them.
#
# Generate one:
#     python -c "import secrets; print(secrets.token_hex(32))"
PRAKALP_SECRET_KEY=change-me-run-the-command-above


# ── Imagery redaction register (recommended for any public deployment) ─────
#
# Path to the operator's restricted-site register, consumed by
# analytics_engine/satellite_precision_engine.py. Without it the public tier
# falls back to PUBLISHED CATEGORIES ONLY — critical-infrastructure sectors and
# international border states — and /api/eo/redaction-policy reports that a
# register is missing.
#
# Those defaults are NOT the classified restricted list and cannot substitute
# for it. A deployment serving the public must install the register from the
# competent authority.
#
# Expected shape:
#   {"restricted_sites":     [{"name": "...", "latitude": 0.0,
#                              "longitude": 0.0, "radius_km": 5.0}],
PRAKALP_REDACTION_POLICY=config/redaction_policy.json


# ── Database & Cloud Storage (Supabase PostgreSQL) ─────────────────────────
#
# Direct / Pooler connection string for Supabase PostgreSQL (ap-southeast-1).
# If blank, the platform automatically boots into CSV-fallback mode.
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co

