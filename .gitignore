# GeoNames India dump: 68MB build-time input for geonames_resolver.py.
# Freely re-downloadable (CC-BY 4.0); the resolved coordinates it produces are
# committed in ALL_2207_PROJECTS_GEOREFERENCED.json, so the demo runs without it.
#   curl -O https://download.geonames.org/export/dump/IN.zip && unzip -p IN.zip IN.txt > paimana_extracted/geonames_IN.txt

# Cabinet briefing archive: runtime audit store, written on demand by
# PragatiSaarthiEngine.archive_briefing(). Content-addressed and regenerable;
# the deployment host keeps the durable copy, not the repo.
artifacts/briefings/

# NASA-IBM Prithvi foundation weights (433 MB, Apache-2.0).
# Fetched from https://huggingface.co/ibm-nasa-geospatial/Prithvi-EO-1.0-100M
# rather than vendored: a third-party binary of this size does not belong in a
# government audit repository's history, where it would be re-downloaded on
# every clone and could never be removed. The derived artifacts ARE committed
# (stage_head.json, prithvi_embeddings.npz), so a fresh clone serves cached
# stage predictions without the weights; only live re-encoding of new imagery
# needs them.
analytics_engine/models/prithvi/*.pt

# Scratch renders and shortlists from demo/analysis runs. Regenerable from
# satellite_pipeline/ and not part of the deliverable.
_demo_*.jpg
_mosaic_*.jpg
_single_*.jpg
_demo_top.json
_shortlist.json

# z18 showcase mosaics — 14 MB of baked imagery, regenerable from
# satellite_pipeline/fetch_showcase_z18.py against the verified release ids.
paimana_extracted/satellite_data/showcase_z18/
