# GeoNames India dump: 68MB build-time input for geonames_resolver.py.
# Freely re-downloadable (CC-BY 4.0); the resolved coordinates it produces are
# committed in ALL_2207_PROJECTS_GEOREFERENCED.json, so the demo runs without it.
#   curl -O https://download.geonames.org/export/dump/IN.zip && unzip -p IN.zip IN.txt > paimana_extracted/geonames_IN.txt

# Cabinet briefing archive: runtime audit store, written on demand by
# PragatiSaarthiEngine.archive_briefing(). Content-addressed and regenerable;
# the deployment host keeps the durable copy, not the repo.
artifacts/briefings/
