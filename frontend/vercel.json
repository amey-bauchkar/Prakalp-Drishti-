{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://prakalp-drishti-afeva3b6dgd6dgg4.indiasouthcentral-01.azurewebsites.net/api/:path*" },
    { "source": "/satellite-imagery/:path*", "destination": "https://prakalp-drishti-afeva3b6dgd6dgg4.indiasouthcentral-01.azurewebsites.net/satellite-imagery/:path*" },
    { "source": "/((?!api/|satellite-imagery/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
